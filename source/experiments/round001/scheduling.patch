+    for kt in range(HT):
+        _mm(dst=pu, stationary=wg[:, ((ITL + i) * HT + kt) * 128:((ITL + i) * HT + kt + 1) * 128], moving=x2[:, kt, :])
+    pgs[i] = pg
+    pus[i] = pu
+
