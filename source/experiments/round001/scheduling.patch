+def _phase_d_pipe(x2, wg, act_s, pid, t0, C):
+    pgs = []
+    pus = []
+    for i in range(ITL):
+        pgs.append(0)
+        pus.append(0)
+    for i in range(DPIPE):
+        _pd_m(i, x2, wg, C, pgs, pus)
+    for i in range(ITL):
+        if i + DPIPE < ITL:
+            _pd_m(i + DPIPE, x2, wg, C, pgs, pus)
+        sg = nl.ndarray((128, C), dtype=nl.float32, buffer=nl.sbuf)
+        nisa.activation(dst=sg, op=nl.silu, data=pgs[i])
+        ab = nl.ndarray((128, C), dtype=nl.bfloat16, buffer=nl.sbuf)
+        nisa.tensor_tensor(dst=ab, data1=sg, data2=pus[i], op=nl.multiply)
+        _hd(dst=act_s[pid * ITL + i, :, nl.ds(t0, C)], src=ab)
