+def _pd_m(i, x2, wg, C, pgs, pus):
+    pg = nl.ndarray((128, C), dtype=nl.float32, buffer=nl.psum)
+    for kt in range(HT):
+        _mm(dst=pg, stationary=wg[:, (i * HT + kt) * 128:(i * HT + kt + 1) * 128], moving=x2[:, kt, :])
