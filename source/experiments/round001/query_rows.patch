+        _hd(dst=cs,src=cosT.ap(pattern=[[1,128],[TMAX,128]],offset=t0+qb*128))
+        _hd(dst=sn,src=sinT.ap(pattern=[[1,128],[TMAX,128]],offset=t0+qb*128))
+        nisa.tensor_scalar(dst=sn[:,0:64],data=sn[:,0:64],op0=nl.multiply,operand0=-1.0)
+        cs_l.append(cs)
+        sn_l.append(sn)
+    items=[]
+    ps_l=[]
+    for qb in range(C//128):
+        for nt in range(NT0,16,4):
+            items.append((qb,nt))
+            ps_l.append(0)
+    N=len(items)
+    for n in range(2):
+        _row_m(n,items,x1,wq,ps_l)
+    for n in range(N):
+        if n+2<N:
+            _row_m(n+2,items,x1,wq,ps_l)
+        _row_e(n,items,ps_l,qw,kw,cs_l,sn_l,qT_s,kT_s,v_s,kcache,vcache,l,pid,t0)
+
